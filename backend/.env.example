# ============================================================
# SELECTT PLATFORM — BACKEND PRODUCTION ENVIRONMENT (.env)
# ============================================================

# --- 1. Server Configuration ---
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://selectt.in,https://www.selectt.in,https://admin.selectt.in,http://localhost:5173,http://localhost:5174

# --- 2. Database (Hostinger VPS Local MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=selectt_user
DB_PASS=YourSecureDatabasePassword
DB_NAME=selectt
DB_SSL=false

# --- 3. In-Memory Cache (Hostinger VPS Local Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# --- 4. JWT Authentication & Security ---
JWT_SECRET=s3l3ctt_jwt_$ecret_k3y_2026_super_secure_random_string

# --- 5. ImageKit.io CDN (Image Transformation & WebP/AVIF) ---
IMAGEKIT_PUBLIC_KEY=public_6cuIDfKYa22dql//M1rxKCv0Y0o=
IMAGEKIT_PRIVATE_KEY=private_zhPh1CfqVPsDiqwgzth5v3auCAo=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/selectt

# --- 6. Bunny.net Stream (HLS Video Transcoding & Playback) ---
BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id
BUNNY_STREAM_API_KEY=your_bunny_api_key
BUNNY_STREAM_CDN_HOSTNAME=iframe.mediadelivery.net

# --- 7. Cloudflare R2 / S3 Storage (Optional Raw Media Storage) ---
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=selectt-production-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.selectt.in

# --- 8. Razorpay Payment Gateway (Live / Test Credentials) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- 9. Email & Notifications (SendGrid / SMTP & WhatsApp) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
WHATSAPP_API_TOKEN=your_meta_whatsapp_api_token
